# OpenRouter API Configuration
# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model selection (default: Claude Sonnet 4)
# Options: anthropic/claude-sonnet-4, anthropic/claude-3.5-sonnet, anthropic/claude-3-opus
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# Site URL (for OpenRouter referer header)
NEXT_PUBLIC_SITE_URL=https://pitch2v.com
